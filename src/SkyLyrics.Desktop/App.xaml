<Application x:Class="SkyLyrics.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0A0D12" />
        <SolidColorBrush x:Key="PanelBackground" Color="#111821" />
        <SolidColorBrush x:Key="PanelBorder" Color="#25313D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#83E1D2" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F1F5F8" />
        <SolidColorBrush x:Key="SecondaryText" Color="#93A1AE" />
    </Application.Resources>
</Application>
