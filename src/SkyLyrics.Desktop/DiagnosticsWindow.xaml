<Window x:Class="SkyLyrics.Desktop.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics · Diagnostics" Width="760" Height="560"
        MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="{StaticResource PoppinsFontFamily}">
    <Grid Margin="25">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource EyebrowTextStyle}" />
            <TextBlock Text="Runtime diagnostics" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="Live process and synchronization telemetry · refreshes every 3 seconds"
                       FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="MEMORY · WORKING SET" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock x:Name="WorkingSetText" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,0" />
                    <TextBlock Text="Physical memory mapped to the process" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,8">
                <StackPanel>
                    <TextBlock Text="MEMORY · MANAGED HEAP" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock x:Name="ManagedHeapText" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,0" />
                    <TextBlock Text="Current managed allocation estimate" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="SCENE REVISION" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock x:Name="SceneRevisionText" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,0" />
                    <TextBlock Text="Immutable synchronized scene updates" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,8">
                <StackPanel>
                    <TextBlock Text="ARTWORK PAYLOAD" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock x:Name="ArtworkBytesText" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,0" />
                    <TextBlock Text="Artwork supplied by the media session" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="PLAYBACK STATE" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock x:Name="PlaybackStatusText" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,0" />
                    <TextBlock Text="Current media session state" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="LAST SCENE UPDATE" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock x:Name="SceneUpdatedText" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,0" />
                    <TextBlock Text="Local time of the last state transition" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock Text="Telemetry is local to this application process." FontSize="10"
                       Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
            <Button Content="CLOSE" Style="{StaticResource PrimaryActionButtonStyle}"
                    HorizontalAlignment="Right" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>