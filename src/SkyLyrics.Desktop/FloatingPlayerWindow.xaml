<Window x:Class="SkyLyrics.Desktop.FloatingPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics · Mini Player"
        Icon="/SkyLyrics.Desktop;component/Assets/SkyLyrics.ico"
        Width="430" Height="242" MinWidth="330" MinHeight="190"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="8" CornerRadius="18" Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="5" Height="20" CornerRadius="3"
                            Background="{DynamicResource AccentBrush}" />
                    <TextBlock Text="  SKYLYRICS MINI" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Padding="8,4" Content="×" FontSize="16"
                        Click="Close_Click" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource PanelBackgroundRaised}">
                    <Image Source="{Binding AlbumArtwork}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArtistLine}" FontSize="10"
                               Foreground="{DynamicResource SecondaryText}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding ActiveLyricText}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxHeight="50" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SyncStatusLabel}" FontSize="8"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SyncPositionLabel}" FontSize="9"
                               Foreground="{DynamicResource SecondaryText}" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
