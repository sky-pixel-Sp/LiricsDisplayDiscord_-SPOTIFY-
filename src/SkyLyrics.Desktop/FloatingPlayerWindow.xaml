<Window x:Class="SkyLyrics.Desktop.FloatingPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics · Mini Player" Icon="/SkyLyrics.Desktop;component/Assets/SkyLyrics.ico"
        Width="430" Height="260" MinWidth="340" MinHeight="210"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource PoppinsFontFamily}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="7" CornerRadius="22" Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="17">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                    <TextBlock Text="  SKYLYRICS  /  MINI PLAYER" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="×" Width="30" Height="28" Padding="0"
                        Style="{StaticResource QuietActionButtonStyle}" HorizontalAlignment="Right"
                        Click="Close_Click" ToolTip="Close Mini Player" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,13,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="60" Height="60" CornerRadius="12" ClipToBounds="True"
                        Background="{DynamicResource PanelBackgroundRaised}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <Image Source="{Binding AlbumArtwork}" Stretch="UniformToFill"
                           Visibility="{Binding HasAlbumArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArtistLine}" FontSize="10" Foreground="{DynamicResource SecondaryText}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding ActiveLyricText}" FontSize="{DynamicResource LyricsMiniFontSize}" FontFamily="{DynamicResource LyricsFontFamily}" TextAlignment="{DynamicResource LyricsTextAlignment}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="54" />
                <TextBlock Text="{Binding StageEmptyStateText}" Visibility="{Binding ShowStageEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{DynamicResource SecondaryText}"
                           TextWrapping="Wrap" MaxHeight="32" Margin="0,5,0,0" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SyncStatusLabel}" FontSize="8" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SyncPositionLabel}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>