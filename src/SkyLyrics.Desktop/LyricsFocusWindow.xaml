<Window x:Class="SkyLyrics.Desktop.LyricsFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics · Focus" WindowStyle="None" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource PoppinsFontFamily}"
        KeyDown="Window_KeyDown">
    <Grid Margin="58">
        <Image Source="{Binding AlbumArtwork}" Stretch="UniformToFill" Opacity="{DynamicResource LyricsArtworkOpacity}"
               RenderOptions.BitmapScalingMode="LowQuality"
               Visibility="{Binding HasAlbumArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F00B1014" Offset="0" />
                    <GradientStop Color="#E9141A1F" Offset="0.5" />
                    <GradientStop Color="#F20B1014" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="SL" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="13,0,0,0">
                        <TextBlock Text="SKYLYRICS  /  FOCUS SESSION" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding StatusTitle}" Margin="0,7,0,0" FontSize="17"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ArtistLine}" Margin="0,3,0,0" FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>
                <Button Content="EXIT FOCUS  ·  ESC" Style="{StaticResource QuietActionButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="Exit_Click" />
            </Grid>
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1500" Margin="36,20">
                    <TextBlock Text="{Binding PreviousLyricText}" FontSize="{DynamicResource LyricsSecondaryFontSize}" FontFamily="{DynamicResource LyricsFontFamily}" TextAlignment="{DynamicResource LyricsTextAlignment}" Foreground="{DynamicResource SecondaryText}"
                               Opacity="0.64" TextWrapping="Wrap" Margin="0,0,0,38" />
                    <TextBlock Text="{Binding ActiveLyricText}" FontSize="{DynamicResource LyricsActiveFontSize}" FontFamily="{DynamicResource LyricsFontFamily}" TextAlignment="{DynamicResource LyricsTextAlignment}" FontWeight="SemiBold" LineHeight="82"
                               Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StageEmptyStateText}" Visibility="{Binding ShowStageEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="19" Foreground="{DynamicResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,19,0,0" />
                    <TextBlock Text="{Binding ActiveWordText}" FontSize="{DynamicResource LyricsWordFontSize}" FontFamily="{DynamicResource LyricsFontFamily}"
                               Foreground="{DynamicResource AccentBrush}" TextAlignment="{DynamicResource LyricsTextAlignment}" Margin="0,24,0,0" />
                    <TextBlock Text="{Binding UpcomingLyricText}" FontSize="{DynamicResource LyricsUpcomingFontSize}" FontFamily="{DynamicResource LyricsFontFamily}" TextAlignment="{DynamicResource LyricsTextAlignment}" Foreground="{DynamicResource SecondaryText}"
                               Opacity="0.78" TextWrapping="Wrap" Margin="0,42,0,0" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LyricsModeLabel}" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SyncStatusLabel}" FontSize="10"
                           Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding SyncPositionLabel}" FontSize="13"
                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Window>