<Window x:Class="SkyLyrics.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="SkyLyrics Desktop"
        Width="1180"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI Variable Display">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="11"
                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                    <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/headphones.svg"
                                     Width="19" Height="19"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SKYLYRICS" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}" />
                    <TextBlock Text="DESKTOP · CINEMATIC LYRICS" Margin="0,2,0,0"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Padding="12,8" CornerRadius="20" Background="#14212A"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SessionBadgeText}" Margin="8,0,0,0"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Click="ImportLyrics_Click">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/list-music.svg"
                                         Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="IMPORT LYRICS" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,18" Padding="17" CornerRadius="20"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="82" Height="82" CornerRadius="14" Background="#0A1118"
                        BorderBrush="#30414D" BorderThickness="1" ClipToBounds="True">
                    <Image Source="{Binding AlbumArtwork}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasAlbumArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,3,12,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="23" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArtistLine}" Margin="0,5,0,0" FontSize="13"
                               Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArtworkAvailabilityLabel}" Margin="0,9,0,0"
                               FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PlaybackStatusLabel}" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding PositionLabel}" Margin="0,8,0,0" FontSize="18"
                               FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SourceIdentityLabel}" Margin="0,6,0,0" FontSize="9"
                               Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="24" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" Background="#0D141C" ClipToBounds="True">
                <Grid>
                    <Image x:Name="ArtworkBackdrop" Source="{Binding AlbumArtwork}" Stretch="UniformToFill"
                           Opacity="0.15" RenderOptions.BitmapScalingMode="LowQuality"
                           Visibility="{Binding HasAlbumArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#ED091018" Offset="0" />
                                <GradientStop Color="#D90E1B25" Offset="0.56" />
                                <GradientStop Color="#F0091118" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Margin="34,27,34,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/audio-lines.svg"
                                                 Width="17" Height="17" Margin="0,0,9,0" />
                                <TextBlock Text="LIVE LYRIC STAGE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LyricsModeLabel}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </DockPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                    Margin="0,10,0,12">
                            <TextBlock Text="{Binding PreviousLyricText}"
                                       Visibility="{Binding HasPreviousLyric, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="17" FontWeight="Medium" Foreground="#8999A6"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="56"
                                       Margin="0,0,0,18" />

                            <TextBlock x:Name="ActiveLyricTextBlock" Text="{Binding ActiveLyricText}"
                                       Visibility="{Binding HasActiveLine, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="38" FontWeight="SemiBold" LineHeight="48"
                                       Foreground="{StaticResource PrimaryText}" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxHeight="150" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <TextBlock Text="{Binding StageEmptyStateText}"
                                       Visibility="{Binding ShowStageEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="18" FontWeight="Medium" Foreground="{StaticResource SecondaryText}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,8" />

                            <TextBlock Text="{Binding ActiveWordText}"
                                       Visibility="{Binding HasActiveWord, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" TextAlignment="Center"
                                       Margin="0,17,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding UpcomingLyricText}"
                                       Visibility="{Binding HasUpcomingLyric, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="14" Foreground="#A8B6C0" TextWrapping="Wrap" MaxWidth="720" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding SyncStatusLabel}" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SyncPositionLabel}" Margin="12,0,0,0"
                                           FontSize="10" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="20,15" CornerRadius="18"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="FULL LYRICS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryText}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LyricsStatusText}" FontSize="9"
                                   Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="550" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding LyricsText}" FontSize="15" LineHeight="25"
                                   Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="2,16,2,0">
            <TextBlock DockPanel.Dock="Left" Text="SYNC DATA  ·  SOURCE TIMESTAMPS ONLY  ·  NO AUDIO CAPTURE"
                       FontSize="9" Foreground="{StaticResource MutedText}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="9"
                       Foreground="{StaticResource SecondaryText}" />
        </DockPanel>
    </Grid>
</Window>