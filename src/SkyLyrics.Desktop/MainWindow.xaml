<Window x:Class="SkyLyrics.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics Desktop"
        Width="960"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI Variable Display">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,28">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SKYLYRICS"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="DESKTOP"
                           Margin="0,3,0,0"
                           FontSize="10"
                           Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Padding="12,7"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    Background="#171F29">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="FOUNDATION READY"
                               Margin="8,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="1"
                CornerRadius="24"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                Background="{StaticResource PanelBackground}">
            <Grid Margin="38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PHASE 0  /  SOLUTION BASELINE"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryText}" />

                <TextBlock Grid.Row="1"
                           Text="{Binding StatusTitle}"
                           Margin="0,18,0,0"
                           FontSize="34"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            MaxWidth="650">
                    <TextBlock Text="{Binding StatusDescription}"
                               FontSize="16"
                               LineHeight="27"
                               Foreground="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,26,0,0"
                            Padding="16"
                            CornerRadius="14"
                            Background="#0C1219"
                            BorderBrush="#1F2A35"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="NEXT MILESTONE"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding NextMilestone}"
                                       Margin="0,8,0,0"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <DockPanel Grid.Row="3" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="CORE  ·  APPLICATION  ·  WPF"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding VersionLabel}"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryText}" />
                </DockPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="2,18,0,0"
                   Text="Spotify playback, lyrics retrieval, synchronization and external outputs are introduced in their assigned phases."
                   FontSize="11"
                   Foreground="{StaticResource SecondaryText}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
