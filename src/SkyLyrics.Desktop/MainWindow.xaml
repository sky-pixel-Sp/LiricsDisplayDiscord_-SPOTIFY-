<Window x:Class="SkyLyrics.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:controls="clr-namespace:SkyLyrics.Desktop.Controls"
        Title="SkyLyrics Desktop" Icon="/SkyLyrics.Desktop;component/Assets/SkyLyrics.ico"
        Width="1280" Height="800" MinWidth="980" MinHeight="610"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="Manual" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI Variable Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid" Margin="20" Opacity="0">
        <Grid.RenderTransform><TranslateTransform Y="10" /></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /><ColumnDefinition Width="272" /></Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/headphones.svg" Width="20" Height="20"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SKYLYRICS" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="YOUR MUSIC, IN SYNC" Margin="0,3,0,0" FontSize="9"
                               FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="16" Padding="11,7" Margin="0,0,10,0"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SessionBadgeText}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding VersionLabel}" FontSize="9" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Grid.Column="0" Padding="11" CornerRadius="20"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="9,8,0,18">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Your listening space" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource PanelBorder}" Margin="0,0,0,6" IsTabStop="True">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/audio-lines.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Live lyrics" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OpenVisualStudio_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/list-music.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Visual Studio" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OpenFocus_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/focus.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Focus mode" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ToggleMini_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/panel-bottom.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Mini player" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ToggleGameMode_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/gamepad-2.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Game Mode" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FullscreenButton" Style="{StaticResource SidebarNavButtonStyle}" Click="ToggleFullscreen_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/maximize-2.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock x:Name="FullscreenLabel" Text="FULL SCREEN" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Border Height="1" Margin="7,12,7,14" Background="{DynamicResource PanelBorder}" />
                    <TextBlock Text="TOOLS" Style="{StaticResource EyebrowTextStyle}" Margin="9,0,0,9" />
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OpenLibrary_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/list-music.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Library" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ImportLyrics_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/file-music.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Import lyrics" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="ImportTranslation_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/file-music.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Import translation" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="RemoveTranslation_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/file-music.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Remove translation" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OpenDiagnostics_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/activity.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Diagnostics" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Height="1" Margin="7,0,7,13" Background="{DynamicResource PanelBorder}" />
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Click="OpenSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/settings-2.svg" Width="17" Height="17" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="CTRL + ALT + K  ·  FOCUS" FontSize="8" Foreground="{DynamicResource MutedText}" Margin="10,13,0,1" />
                    <TextBlock Text="CTRL + ALT + M  ·  MINI" FontSize="8" Foreground="{DynamicResource MutedText}" Margin="10,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="2" Grid.Column="1" Margin="16,0">
            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="164" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LIVE LYRICS" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Stay with the moment." FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="14" Padding="10,7"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding LyricsModeLabel}" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" CornerRadius="24" Padding="25,20" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Image x:Name="ArtworkBackdrop" Source="{Binding AlbumArtwork}" Stretch="UniformToFill" Opacity="0.15"
                           RenderOptions.BitmapScalingMode="LowQuality"
                           Visibility="{Binding HasAlbumArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D90B1115" Offset="0" />
                                <GradientStop Color="#E9161D21" Offset="0.52" />
                                <GradientStop Color="#F20B1014" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <controls:MusicWaveformControl
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="180"
                        Position="{Binding MusicVisualPosition}"
                        IsPlaying="{Binding MusicVisualIsPlaying}"
                        MotionEnabled="{Binding MusicVisualMotionEnabled}"
                        AccentColor="{Binding ArtworkAccentColor}"
                        QualityTier="{Binding CinematicQualityTier}"
                        Visibility="{Binding ShowPlaybackVisual, Converter={StaticResource BooleanToVisibilityConverter}}"
                        IsHitTestVisible="False" Opacity="0.9" />
                    <Canvas IsHitTestVisible="False"
                            Visibility="{Binding ShowPlaybackVisual, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <svgc:SvgViewbox x:Name="FloatingNoteOne"
                            Source="/SkyLyrics.Desktop;component/Assets/Notes/note-mint.svg"
                            Width="24" Height="32" Canvas.Left="44" Canvas.Top="70" Opacity="0.52"
                            RenderTransformOrigin="0.5,0.5">
                            <svgc:SvgViewbox.RenderTransform><TranslateTransform Y="0" /></svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <svgc:SvgViewbox x:Name="FloatingNoteTwo"
                            Source="/SkyLyrics.Desktop;component/Assets/Notes/note-blue.svg"
                            Width="22" Height="28" Canvas.Right="76" Canvas.Top="124" Opacity="0.46"
                            RenderTransformOrigin="0.5,0.5">
                            <svgc:SvgViewbox.RenderTransform><TranslateTransform Y="0" /></svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <svgc:SvgViewbox x:Name="FloatingNoteThree"
                            Source="/SkyLyrics.Desktop;component/Assets/Notes/note-violet.svg"
                            Width="18" Height="23" Canvas.Left="160" Canvas.Bottom="40" Opacity="0.38"
                            RenderTransformOrigin="0.5,0.5">
                            <svgc:SvgViewbox.RenderTransform><TranslateTransform Y="0" /></svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                    </Canvas>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/audio-lines.svg" Width="16" Height="16" Margin="0,0,9,0" />
                                <TextBlock Text="THE LYRIC STAGE" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SyncStatusLabel}" FontSize="9"
                                       FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" />
                        </DockPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="8,12">
                            <TextBlock x:Name="PreviousLyricTextBlock" Text="{Binding PreviousLyricText}"
                                       Visibility="{Binding HasPreviousLyric, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="16" FontWeight="Medium" Foreground="{DynamicResource SecondaryText}"
                                       Opacity="0.76" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="50" Margin="0,0,0,23" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1" /><TranslateTransform Y="0" /></TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="ActiveLyricTextBlock" Text="{Binding ActiveLyricText}"
                                       Visibility="{Binding HasActiveLine, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="36" FontWeight="SemiBold" LineHeight="46" Foreground="{DynamicResource PrimaryText}"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="140" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1" /><TranslateTransform Y="0" /></TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="{Binding StageEmptyStateText}"
                                       Visibility="{Binding ShowStageEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="16" FontWeight="Medium" Foreground="{DynamicResource SecondaryText}"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding ActiveWordText}"
                                       Visibility="{Binding HasActiveWord, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                       TextAlignment="Center" Margin="0,16,0,0" />
                            <StackPanel Visibility="{Binding HasTranslationDisplay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,16,0,0">
                                <TextBlock Text="{Binding TranslationModeLabel}" FontSize="9"
                                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding TranslationDisplayText}" FontSize="20"
                                           Foreground="{DynamicResource SecondaryText}" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxHeight="90" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <TextBlock x:Name="UpcomingLyricTextBlock" DockPanel.Dock="Left" Text="{Binding UpcomingLyricText}"
                                       Visibility="{Binding HasUpcomingLyric, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxWidth="430" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1" /><TranslateTransform Y="0" /></TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SyncPositionLabel}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="16,13" CornerRadius="19"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="LYRICS" Style="{StaticResource EyebrowTextStyle}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding CandidateSearchButtonText}"
                                    Click="SearchLyricsCandidates_Click"
                                    IsEnabled="{Binding CanSearchLyricsCandidates}"
                                    Visibility="{Binding ShowCandidateSearchButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="10,5" Margin="0,0,10,0" FontSize="9" FontWeight="SemiBold"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                            <TextBlock Text="{Binding LyricsStatusText}" FontSize="9"
                                       Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="300"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LyricsPanel" RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1" /><TranslateTransform Y="0" /></TransformGroup>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding CandidateSearchStatus}" FontSize="10"
                                       Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                                       Margin="0,0,0,9" />
                            <ItemsControl ItemsSource="{Binding LyricsCandidates}"
                                          Visibility="{Binding HasLyricsCandidates, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12" Margin="0,0,0,8"
                                                Background="{DynamicResource PanelBackgroundRaised}"
                                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Result.Document.Title}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Result.Document.Artist}" FontSize="10"
                                                               Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <WrapPanel Margin="0,7,0,0">
                                                        <TextBlock Text="{Binding ScoreLabel}" FontSize="9"
                                                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                                   Margin="0,0,12,0" />
                                                        <TextBlock Text="{Binding DurationLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource MutedText}" />
                                                        <TextBlock Text="{Binding MatchStatusLabel}"
                                                                   FontSize="9" Foreground="{DynamicResource MutedText}"
                                                                   Margin="10,0,0,0" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding MatchReason}" FontSize="9"
                                                               Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                                                               Margin="0,6,8,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Gunakan"
                                                        Tag="{Binding}" Click="SelectLyricsCandidate_Click"
                                                        IsEnabled="{Binding IsExactSignatureMatch}"
                                                        Padding="11,7" Margin="12,0,0,0"
                                                        VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        Foreground="{DynamicResource PrimaryText}"
                                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="ORIGINAL LYRICS" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding LyricsText}" FontSize="12" LineHeight="19"
                                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TranslationModeLabel}"
                                       Visibility="{Binding HasTranslation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Style="{StaticResource EyebrowTextStyle}" Margin="0,14,0,6" />
                            <TextBlock Text="{Binding TranslationFullText}"
                                       Visibility="{Binding HasTranslation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="12" LineHeight="19" Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TranslationStatusText}"
                                       Visibility="{Binding HasTranslation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="9" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer x:Name="RightSidebar" Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Border Style="{StaticResource PanelCardStyle}" Padding="15">
                <StackPanel>
                    <TextBlock Text="NOW PLAYING" Style="{StaticResource EyebrowTextStyle}" />
                    <Border Width="196" Height="196" CornerRadius="16" ClipToBounds="True"
                            Background="{DynamicResource PanelBackgroundRaised}" BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1" HorizontalAlignment="Center" Margin="0,13,0,14">
                        <Grid>
                            <Image Source="{Binding AlbumArtwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasAlbumArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAlbumArtwork}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <svgc:SvgViewbox Source="/SkyLyrics.Desktop;component/Assets/Icons/headphones.svg" Width="34" Height="34"
                                                 HorizontalAlignment="Center" />
                                <TextBlock Text="SKYLYRICS" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ArtistLine}" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxHeight="38" Margin="0,5,0,0" />
                    <Border Height="1" Background="{DynamicResource PanelBorder}" Margin="0,15,0,13" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PLAYBACK" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding PlaybackStatusLabel}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PositionLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,12,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="SESSION" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding StatusDescription}" FontSize="10" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,8,0,10" />
                    <TextBlock Text="SOURCE IDENTITY" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding SourceIdentityLabel}" FontSize="9" Foreground="{DynamicResource MutedText}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                    <Border Height="1" Background="{DynamicResource PanelBorder}" Margin="0,12,0,10" />
                    <DockPanel>
                        <TextBlock Text="LYRIC STATUS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding LyricsModeLabel}" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding LyricsStatusText}" FontSize="10" Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap" MaxHeight="40" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>