<Window x:Class="SkyLyrics.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics Desktop v0.4.0"
        Height="760" Width="1120"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Margin="26" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="12"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Static ambient color fields: no animated background loop or per-frame GPU work. -->
        <Canvas Grid.RowSpan="6" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="560" Height="420" Canvas.Left="500" Canvas.Top="-205" Opacity="0.19">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3267D7B0" Offset="0"/>
                        <GradientStop Color="#0067D7B0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="420" Height="340" Canvas.Left="-190" Canvas.Top="410" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#293DAB82" Offset="0"/>
                        <GradientStop Color="#003DAB82" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Brand / connection / appearance -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="13"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="S" FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="5" Height="5" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,7,7"/>
                    </Grid>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SkyLyrics" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="SPOTIFY DESKTOP COMPANION"
                               Style="{StaticResource EyebrowTextStyle}" Margin="1,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="11" Padding="12,9" Margin="0,0,10,0">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7"
                                 Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ConnectionText" Text="Checking Spotify…"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="11" Padding="10,8" Margin="0,0,7,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DiscordConnectionDot" Width="7" Height="7"
                                 Fill="#65736C" Margin="0,0,7,0"/>
                        <TextBlock x:Name="DiscordStatusText" Text="Discord not configured"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="DiscordButton" Content="Set up"
                        Click="DiscordButton_Click" Style="{StaticResource QuietButtonStyle}"
                        Padding="12,9" Margin="0,0,5,0"/>
                <Button x:Name="DiscordSettingsButton" Content="⚙"
                        Click="DiscordSettingsButton_Click" Style="{StaticResource QuietButtonStyle}"
                        Padding="10,9" Margin="0,0,9,0" ToolTip="Discord settings"/>
                <Button x:Name="ThemeButton" Content="Light theme"
                        Click="ThemeButton_Click" Style="{StaticResource QuietButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Now playing -->
        <Border x:Name="NowPlayingCard" Grid.Row="2" Opacity="0"
                MouseEnter="SurfaceCard_MouseEnter" MouseLeave="SurfaceCard_MouseLeave"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="20" Padding="21"
                Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <Border Height="2" VerticalAlignment="Top" CornerRadius="1" Margin="2,0,2,0"
                        IsHitTestVisible="False" Opacity="0.72">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0067D7B0" Offset="0"/>
                            <GradientStop Color="#A167D7B0" Offset="0.48"/>
                            <GradientStop Color="#0067D7B0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="NOW PLAYING" Style="{StaticResource EyebrowTextStyle}"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,9"/>
                    <TextBlock x:Name="TrackTitle" Text="Open Spotify Desktop to begin"
                               FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="TrackArtist" Text="Your current track will appear here"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="54"
                        Background="{DynamicResource StrokeBrush}"
                        Margin="22,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="9" Padding="10,6"
                            HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="PlaybackDot" Width="6" Height="6"
                                     Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="PlaybackText" Text="WAITING FOR SPOTIFY"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <StackPanel x:Name="PlaybackEqualizer" Orientation="Horizontal"
                                        Height="12" Margin="9,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="EqualizerBar1" Width="2.5" Height="5" Margin="1,0" RenderTransformOrigin="0.5,1"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                        VerticalAlignment="Bottom">
                                    <Border.RenderTransform><ScaleTransform ScaleY="0.5"/></Border.RenderTransform>
                                                                    </Border>
                                <Border x:Name="EqualizerBar2" Width="2.5" Height="10" Margin="1,0" RenderTransformOrigin="0.5,1"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                        VerticalAlignment="Bottom">
                                    <Border.RenderTransform><ScaleTransform ScaleY="0.5"/></Border.RenderTransform>
                                </Border>
                                <Border x:Name="EqualizerBar3" Width="2.5" Height="7" Margin="1,0" RenderTransformOrigin="0.5,1"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                        VerticalAlignment="Bottom">
                                    <Border.RenderTransform><ScaleTransform ScaleY="0.5"/></Border.RenderTransform>
                                </Border>
                                <Border x:Name="EqualizerBar4" Width="2.5" Height="11" Margin="1,0" RenderTransformOrigin="0.5,1"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                        VerticalAlignment="Bottom">
                                    <Border.RenderTransform><ScaleTransform ScaleY="0.5"/></Border.RenderTransform>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PositionText" Text="0:00 / 0:00"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Right"/>
                    <ProgressBar x:Name="TrackProgress" Height="6" Margin="0,8,0,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Background="{DynamicResource ProgressTrackBrush}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lyrics surface -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lyrics" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="7" Padding="8,4" Margin="11,0,0,0">
                        <TextBlock x:Name="LyricsStateText" Text="NOT LOADED"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CustomizeButton" Content="Customize"
                            Click="CustomizeButton_Click" Style="{StaticResource QuietButtonStyle}"
                            Padding="13,9" Margin="0,0,7,0"
                            ToolTip="Choose from 30 animations, 30 effects and 30 backgrounds"/>
                    <Button x:Name="GameModeButton" Content="Game mode"
                            Click="GameModeButton_Click" Style="{StaticResource QuietButtonStyle}"
                            Padding="13,9" Margin="0,0,7,0"
                            ToolTip="Show one synchronized lyric line in a top overlay"/>
                    <Button x:Name="ImportButton" Content="Import lyrics"
                            Click="ImportLyrics_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="16,9"/>
                </StackPanel>
            </Grid>

            <Border x:Name="LyricsCard" Grid.Row="2" Opacity="0"
                    MouseEnter="SurfaceCard_MouseEnter" MouseLeave="SurfaceCard_MouseLeave"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="24"
                    Effect="{StaticResource CardShadowEffect}">
                <ScrollViewer x:Name="LyricsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                    <StackPanel x:Name="LyricsPanel">
                        <StackPanel x:Name="LyricsEmptyText" Margin="0,52,0,0"
                                    HorizontalAlignment="Center" MaxWidth="430" Opacity="0.92">
                            <Border Width="54" Height="54" CornerRadius="17"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock Text="♪" FontSize="29"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Your lyrics, in sync"
                                       FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Start a track in Spotify Desktop. SkyLyrics will look for a verified lyrics source, or you can import an LRC file."
                                       FontSize="12" LineHeight="20"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Trust / version footer -->
        <Grid Grid.Row="5" Margin="2,13,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="Lyrics are never fabricated · Unsynced sources stay labeled"
                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="SKYLyrics  /  v0.4.0  /  WINDOWS 11"
                       FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
