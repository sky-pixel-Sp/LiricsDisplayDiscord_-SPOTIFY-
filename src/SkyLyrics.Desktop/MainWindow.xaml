<Window x:Class="SkyLyrics.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics Desktop"
        Width="980"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI Variable Display">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,26">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SKYLYRICS"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="DESKTOP"
                           Margin="0,3,0,0"
                           FontSize="10"
                           Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="IMPORT LYRICS"
                        Click="ImportLyrics_Click"
                        Padding="14,9"
                        Margin="0,0,14,0"
                        Background="#1B2933"
                        Foreground="{StaticResource PrimaryText}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="SemiBold" />
                <Border Padding="12,7"
                        CornerRadius="20"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1"
                        Background="#171F29">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SessionBadgeText}"
                                   Margin="8,0,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                CornerRadius="24"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                Background="{StaticResource PanelBackground}">
            <Grid Margin="34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PHASE 3  /  LIVE SYNC ENGINE"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryText}" />

                <TextBlock Grid.Row="1"
                           Text="{Binding StatusTitle}"
                           Margin="0,14,0,0"
                           FontSize="32"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ArtistLine}"
                               FontSize="14"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusDescription}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="13"
                            Background="#0C1219"
                            BorderBrush="#1F2A35"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PlaybackStatusLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SourceIdentityLabel}"
                                           Margin="0,7,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PositionLabel}"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryText}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,20,0,18"
                        Padding="20"
                        CornerRadius="16"
                        Background="#0C1219"
                        BorderBrush="#25313D"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="LYRICS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding LyricsModeLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding LyricsStatusText}"
                                   Margin="0,8,0,12"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" />
                        <Border Grid.Row="2"
                                Margin="0,0,0,14"
                                Padding="18"
                                CornerRadius="13"
                                Background="#111A22"
                                BorderBrush="#263642"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="ACTIVE LINE"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryText}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SyncPositionLabel}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </DockPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding ActiveLyricText}"
                                           Margin="0,10,0,5"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           LineHeight="36"
                                           Foreground="{StaticResource PrimaryText}"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Margin="0,2,0,12">
                                    <TextBlock Text="{Binding ActiveWordText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding ActiveWordProgressLabel}"
                                               Margin="10,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <DockPanel Grid.Row="3" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding UpcomingLyricText}"
                                               FontSize="13"
                                               Foreground="{StaticResource SecondaryText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SyncStatusLabel}"
                                               Margin="12,0,0,0"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </DockPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding LyricsText}"
                                       FontSize="17"
                                       LineHeight="29"
                                       Foreground="{StaticResource PrimaryText}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="4" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="CORE  ·  APPLICATION  ·  WINDOWS  ·  WPF"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryText}" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding VersionLabel}"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryText}" />
                </DockPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="2,16,0,0"
                   Text="Lyrics remain unsynced unless original source timestamps are present. Word timing is only shown when supplied by the file or provider."
                   FontSize="11"
                   Foreground="{StaticResource SecondaryText}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
