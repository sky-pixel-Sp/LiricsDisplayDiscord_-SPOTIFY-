<Window x:Class="SkyLyrics.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics · Settings" Width="640" Height="700"
        MinWidth="560" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI Variable Display">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PREFERENCES" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Appearance, synchronization and external outputs"
                       FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
            <StackPanel>
                <Border Padding="16" CornerRadius="14" Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Theme" Margin="0,13,0,5" />
                        <ComboBox x:Name="ThemeCombo" Width="180" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                        <CheckBox x:Name="ReduceMotionCheck" Content="Reduce application motion"
                                  Margin="0,14,0,0" />
                        <CheckBox x:Name="MiniPlayerTopmostCheck" Content="Keep mini player above other windows"
                                  Margin="0,10,0,0" />
                        <Button Content="CONFIGURE GAME MODE" HorizontalAlignment="Left"
                                Margin="0,16,0,0" Padding="13,9" Click="ConfigureGameMode_Click" />
                        <TextBlock Text="Resize, move, change its visual style, or close Game Mode directly from the overlay."
                                   FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="14" Margin="0,12,0,0"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LYRIC SYNCHRONIZATION" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Playback offset in milliseconds (-500 to +500)"
                                   Margin="0,13,0,5" />
                        <TextBox x:Name="OffsetBox" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="14" Margin="0,12,0,0"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DISCORD RICH PRESENCE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <CheckBox x:Name="DiscordEnabledCheck" Content="Publish current Spotify track to Discord"
                                  Margin="0,13,0,0" />
                        <TextBlock Text="Discord Application ID (from your Discord Developer Portal)"
                                   Margin="0,10,0,5" />
                        <TextBox x:Name="DiscordApplicationIdBox" MaxLength="22" />
                        <TextBlock Text="The Discord desktop client must be running. No account token is requested."
                                   FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="14" Margin="0,12,0,0"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="OBS BROWSER OVERLAY" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <CheckBox x:Name="ObsEnabledCheck" Content="Enable local OBS overlay server"
                                  Margin="0,13,0,0" />
                        <TextBlock Text="HTTP port (loopback only)" Margin="0,10,0,5" />
                        <TextBox x:Name="ObsPortBox" Width="120" HorizontalAlignment="Left" />
                        <TextBlock Text="Local overlay endpoint; loopback access only."
                                   FontSize="10" Foreground="{DynamicResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" FontSize="10" Foreground="{DynamicResource SecondaryText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="390" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="CANCEL" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="SAVE SETTINGS" Click="Save_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
