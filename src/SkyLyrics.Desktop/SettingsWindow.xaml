<Window x:Class="SkyLyrics.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLyrics · Settings" Width="760" Height="740"
        MinWidth="650" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Display">
    <Grid Margin="25">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PREFERENCES" Style="{StaticResource EyebrowTextStyle}" />
            <TextBlock Text="Make SkyLyrics feel like yours" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="Appearance, synchronization and connected experiences" FontSize="11"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,12">
                    <StackPanel>
                        <TextBlock Text="01  ·  APPEARANCE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Choose your surface" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,13" />
                        <TextBlock Text="Theme" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" MinHeight="34">
                            <ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" />
                        </ComboBox>
                        <CheckBox x:Name="ReduceMotionCheck" Content="Reduce application motion" Margin="0,15,0,0" />
                        <CheckBox x:Name="MiniPlayerTopmostCheck" Content="Keep Mini Player above other windows" Margin="0,10,0,0" />
                        <Button Content="CONFIGURE GAME MODE" Style="{StaticResource QuietActionButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,17,0,0" Click="ConfigureGameMode_Click" />
                        <TextBlock Text="Move, resize and tune the live overlay from its own settings."
                                   FontSize="10" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,12">
                    <StackPanel>
                        <TextBlock Text="02  ·  SYNCHRONIZATION" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Fine-tune lyric timing" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,13" />
                        <TextBlock Text="Playback offset · milliseconds" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6" />
                        <TextBox x:Name="OffsetBox" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="Range: −500 ms to +500 ms. Negative values bring lyrics forward."
                                   FontSize="10" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="03  ·  DISCORD RICH PRESENCE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Share what is playing" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,13" />
                        <CheckBox x:Name="DiscordEnabledCheck" Content="Publish current Spotify track to Discord" />
                        <TextBlock Text="Discord Application ID" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,13,0,6" />
                        <TextBox x:Name="DiscordApplicationIdBox" MaxLength="22" />
                        <TextBlock Text="Use the public Application ID from your Discord Developer Portal. Discord Desktop must be running."
                                   FontSize="10" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="04  ·  OBS BROWSER OVERLAY" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Bring lyrics into your stream" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,13" />
                        <CheckBox x:Name="ObsEnabledCheck" Content="Enable local OBS overlay server" />
                        <TextBlock Text="HTTP port · loopback only" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,13,0,6" />
                        <TextBox x:Name="ObsPortBox" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="The local endpoint remains bound to 127.0.0.1 and is not exposed to your LAN."
                                   FontSize="10" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="10" Foreground="{DynamicResource SecondaryText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="CANCEL" Style="{StaticResource QuietActionButtonStyle}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="SAVE SETTINGS" Style="{StaticResource PrimaryActionButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>