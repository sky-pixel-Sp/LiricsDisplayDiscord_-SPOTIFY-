<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>SkyLyrics.Desktop.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>2.1.0-preview.1</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-preview.1</InformationalVersion>
    <RootNamespace>SkyLyrics.Desktop</RootNamespace>
    <AssemblyName>SkyLyrics.Desktop</AssemblyName>
    <ApplicationIcon>Assets/SkyLyrics.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SkyLyrics.Core/SkyLyrics.Core.csproj" />
    <ProjectReference Include="../SkyLyrics.Application/SkyLyrics.Application.csproj" />
    <ProjectReference Include="../SkyLyrics.Infrastructure.Windows/SkyLyrics.Infrastructure.Windows.csproj" />
    <ProjectReference Include="../SkyLyrics.Infrastructure/SkyLyrics.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SharpVectors.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Icons/*.svg" />
    <Resource Include="Assets/Backgrounds/*.svg" />
    <Resource Include="Assets/Branding/*.svg" />
    <Resource Include="Assets/Notes/*.svg" />
    <Resource Include="Assets/Textures/*.svg" />
    <Resource Include="Assets/Fonts/Poppins/OFL.txt" />
    <Resource Include="Assets/Fonts/BebasNeue/OFL.txt" />
    <Resource Include="Assets/SkyLyrics.ico" />
    <EmbeddedResource Include="Assets/obs-overlay.html" />
  </ItemGroup>
  <Target Name="CompileSkyLyricsPixelShaders"
          BeforeTargets="PrepareResources"
          Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <SkyLyricsFxcPath Condition="'$(SkyLyricsFxcPath)' == ''">$(WindowsSdkDir)bin\$(WindowsSDKVersion)x64\fxc.exe</SkyLyricsFxcPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(SkyLyricsFxcPath)')"
           Text="The Windows SDK fxc.exe compiler is required to build SkyLyrics pixel shaders. Install the Windows 10/11 SDK or set SkyLyricsFxcPath." />
    <MakeDir Directories="$(IntermediateOutputPath)Assets\Effects" />
    <Exec Command="&quot;$(SkyLyricsFxcPath)&quot; /nologo /T ps_3_0 /E main /Fo &quot;$(IntermediateOutputPath)Assets\Effects\Grain.ps&quot; &quot;$(MSBuildProjectDirectory)\Assets\Effects\grain.hlsl&quot;" />
    <Exec Command="&quot;$(SkyLyricsFxcPath)&quot; /nologo /T ps_3_0 /E main /Fo &quot;$(IntermediateOutputPath)Assets\Effects\ChromaticAberration.ps&quot; &quot;$(MSBuildProjectDirectory)\Assets\Effects\chromatic-aberration.hlsl&quot;" />
    <ItemGroup>
      <Resource Include="$(IntermediateOutputPath)Assets\Effects\Grain.ps">
        <Link>Assets/Effects/Grain.ps</Link>
      </Resource>
      <Resource Include="$(IntermediateOutputPath)Assets\Effects\ChromaticAberration.ps">
        <Link>Assets/Effects/ChromaticAberration.ps</Link>
      </Resource>
    </ItemGroup>
  </Target>
</Project>
