<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>SkyLyrics.Desktop.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>2.3.0-preview.1</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <InformationalVersion>2.3.0-preview.1</InformationalVersion>
    <RootNamespace>SkyLyrics.Desktop</RootNamespace>
    <AssemblyName>SkyLyrics.Desktop</AssemblyName>
    <ApplicationIcon>Assets/SkyLyrics.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SkyLyrics.Core/SkyLyrics.Core.csproj" />
    <ProjectReference Include="../SkyLyrics.Application/SkyLyrics.Application.csproj" />
    <ProjectReference Include="../SkyLyrics.Infrastructure.Windows/SkyLyrics.Infrastructure.Windows.csproj" />
    <ProjectReference Include="../SkyLyrics.Infrastructure/SkyLyrics.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SharpVectors.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets/Library/**/*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/Icons/*.svg" />
    <Resource Include="Assets/Backgrounds/*.svg" />
    <Resource Include="Assets/Branding/*.svg" />
    <Resource Include="Assets/Notes/*.svg" />
    <Resource Include="Assets/Textures/*.svg" />
    <Resource Include="Assets/Fonts/Poppins/OFL.txt" />
    <Resource Include="Assets/Fonts/BebasNeue/OFL.txt" />
    <Resource Include="$(IntermediateOutputPath)Assets/Fonts/Poppins/Poppins-Regular.ttf">
      <Link>Assets/Fonts/Poppins/Poppins-Regular.ttf</Link>
    </Resource>
    <Resource Include="$(IntermediateOutputPath)Assets/Fonts/BebasNeue/BebasNeue-Regular.ttf">
      <Link>Assets/Fonts/BebasNeue/BebasNeue-Regular.ttf</Link>
    </Resource>
    <Resource Include="Assets/SkyLyrics.ico" />
    <EmbeddedResource Include="Assets/obs-overlay.html" />
  </ItemGroup>
  <Target Name="CompileSkyLyricsPixelShaders"
          BeforeTargets="PrepareResources;MarkupCompilePass1"
          Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\CompileSkyLyricsShaders.ps1&quot; -OutputDirectory &quot;$(IntermediateOutputPath)Assets\Effects&quot; -FontOutputDirectory &quot;$(IntermediateOutputPath)Assets\Fonts&quot;" />
    <ItemGroup>
      <Resource Include="$(IntermediateOutputPath)Assets\Effects\Grain.ps">
        <Link>Assets/Effects/Grain.ps</Link>
      </Resource>
      <Resource Include="$(IntermediateOutputPath)Assets\Effects\ChromaticAberration.ps">
        <Link>Assets/Effects/ChromaticAberration.ps</Link>
      </Resource>
    </ItemGroup>
  </Target>
</Project>
