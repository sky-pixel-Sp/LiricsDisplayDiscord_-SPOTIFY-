<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#090D12" />
    <SolidColorBrush x:Key="PanelBackground" Color="#111A23" />
    <SolidColorBrush x:Key="PanelBackgroundRaised" Color="#17232D" />
    <SolidColorBrush x:Key="PanelBorder" Color="#263541" />
    <SolidColorBrush x:Key="AccentBrush" Color="#83E1D2" />
    <SolidColorBrush x:Key="PrimaryText" Color="#F0F5F7" />
    <SolidColorBrush x:Key="SecondaryText" Color="#9BAAB5" />
    <SolidColorBrush x:Key="MutedText" Color="#71818D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1D3A3A" />
    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
